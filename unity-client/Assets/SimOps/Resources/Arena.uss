.arena { width: 100%; height: 100%; flex-grow: 1; background-color: #091217; color: #e6eff2; font-size: 18px; }
.page-scroll { flex-grow: 1; }
.page { width: 100%; max-width: 1460px; align-self: center; padding: 16px 30px; }
Label { white-space: normal; margin: 0; padding: 0; }
Button { margin: 0; border-width: 1px; border-color: #344752; border-radius: 8px; color: #e6eff2; background-color: #172a33; -unity-font-style: normal; white-space: normal; padding: 12px 18px; min-height: 52px; }
Button:hover { background-color: #25434d; border-color: #69d5c2; }
Button:focus { border-color: #c1f5e7; border-width: 2px; }
Button:active { background-color: #32615d; }
Button:disabled { opacity: 0.53; }
.header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px; }
.brand { flex-shrink: 1; }
.eyebrow { color: #8da4ad; font-size: 13px; margin-bottom: 2px; }
.brand-title { font-size: 22px; -unity-font-style: bold; }
.mode { padding: 8px 16px; background-color: #23313a; border-radius: 18px; color: #b6c8cf; font-size: 16px; }
.mode.ranked { color: #75dfc1; background-color: #143d36; }
.toolbar { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.section-title { font-size: 19px; -unity-font-style: bold; }
.muted { font-size: 15px; color: #9eb0b9; }
.journey { flex-direction: row; margin-bottom: 12px; }
.step { flex-grow: 1; flex-basis: 0; padding: 4px; margin-right: 6px; border-bottom-width: 3px; border-bottom-color: #2e404a; color: #8b9fa9; font-size: 14px; }
.step.current { color: #86f0cd; border-bottom-color: #6ce5bc; }
.step.done { color: #c1d5d2; border-bottom-color: #368975; }
.combatants { flex-direction: row; }
.fighter { flex-grow: 1; flex-basis: 0; border-width: 1px; border-color: #2e4550; border-radius: 12px; background-color: #14252e; padding: 12px 20px; }
.fighter.player { margin-right: 16px; }
.fighter.enemy { background-color: #291f28; border-color: #543943; }
.fighter-title { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.fighter-name { font-size: 26px; -unity-font-style: bold; }
.health-number { font-size: 24px; color: #d9ebe9; }
.health-track { height: 12px; background-color: #0a151b; border-radius: 6px; overflow: hidden; margin-bottom: 6px; }
.health-fill { height: 100%; width: 100%; background-color: #61d8b3; }
.enemy-fill { background-color: #ed8f92; }
.stats { font-size: 17px; color: #b6cbd1; }
.low-health .health-fill { background-color: #f3ab6d; }
.fighter.hit { background-color: #653037; border-color: #fb8b8b; }
.fighter.heal { background-color: #235846; border-color: #9ff4ce; }
.feedback { color: #f4d49b; font-size: 17px; height: 28px; -unity-text-align: middle-center; margin-top: 2px; }
.phase { margin-bottom: 12px; }
.intent-panel { border-radius: 10px; background-color: #171f29; padding: 10px 18px; margin-bottom: 10px; border-left-width: 3px; border-left-color: #e9b887; }
.intent { font-size: 22px; color: #f1c592; margin-bottom: 2px; -unity-font-style: bold; }
.danger-text { color: #ff9b9e; }
.action-row { flex-direction: row; flex-wrap: wrap; }
.action-card { flex-grow: 1; flex-basis: 0; min-width: 180px; min-height: 112px; margin-right: 8px; margin-bottom: 8px; font-size: 17px; -unity-text-align: middle-left; padding: 12px 16px; }
.action-card.end-turn { background-color: #29303b; border-color: #5c6372; }
.controls-hint { margin: 4px 0; }
.phase-title { font-size: 26px; -unity-font-style: bold; margin-bottom: 6px; }
.reward-phase { background-color: #142b28; border-radius: 12px; padding: 14px 22px; border-width: 1px; border-color: #385e50; }
.reward-row { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.reward-card { flex-basis: 0; flex-grow: 1; min-width: 230px; min-height: 195px; margin-right: 12px; margin-bottom: 8px; -unity-text-align: middle-left; font-size: 19px; background-color: #1c3435; border-top-width: 3px; }
.reward-offense { border-top-color: #ed8f92; }
.reward-defense { border-top-color: #91bcea; }
.reward-sustain { border-top-color: #79d6ac; }
.reward-tactics { border-top-color: #d6b2f1; }
.result-phase { background-color: #172b2a; border-width: 1px; border-color: #3d7060; border-radius: 12px; padding: 14px 24px; }
.score { font-size: 42px; -unity-font-style: bold; color: #a2eed3; margin-bottom: 6px; }
.submission { padding: 6px 0; font-size: 18px; color: #edca9d; }
.result-actions { flex-direction: row; flex-wrap: wrap; }
.result-actions Button { margin-right: 10px; margin-bottom: 6px; min-width: 190px; }
.primary { background-color: #216451; border-color: #539e83; color: #ecfff5; }
.primary:hover { background-color: #2c8268; }
.secondary { background-color: #17252e; }
.message { color: #c3d9da; margin: 6px 0; min-height: 24px; font-size: 17px; }
.footer { flex-direction: row; flex-wrap: wrap; margin-top: 8px; padding-top: 15px; border-top-width: 1px; border-top-color: #253842; }
.footer Button { margin-right: 10px; margin-bottom: 6px; min-width: 175px; }
.online-status { margin-top: 6px; font-size: 15px; color: #9eb8bf; }
.debug { margin-top: 10px; padding: 8px; background-color: #101c23; color: #97aeb9; font-size: 15px; }
.debug-text { font-size: 13px; margin: 12px 0; color: #809aa7; }
.confirm-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(2,8,12,0.9); justify-content: center; align-items: center; }
.confirm-dialog { width: 80%; max-width: 620px; background-color: #1c3038; border-radius: 14px; border-width: 1px; border-color: #628c89; padding: 30px; }
.compact .page { padding: 16px 18px; }
.compact .brand-title { font-size: 21px; }
.compact .fighter { padding: 16px; }
.compact .fighter-title { flex-wrap: wrap; }
.compact .fighter-name { font-size: 23px; margin-right: 12px; }
.compact .action-card { min-width: 200px; }
.compact .reward-card { min-width: 230px; }
.narrow .page, .narrow .phase, .narrow .action-row, .narrow .reward-row { flex-shrink: 0; }
.narrow .action-row, .narrow .reward-row { flex-direction: column; flex-wrap: nowrap; }
.narrow .action-card, .narrow .reward-card { flex-basis: auto; flex-grow: 0; flex-shrink: 0; min-width: 0; width: 100%; }
.narrow .action-card { min-height: 100px; }
.narrow .reward-card { min-height: 160px; }
.page-scroll .unity-scroller--vertical { width: 12px; background-color: #101c23; }
.page-scroll .unity-scroller__low-button, .page-scroll .unity-scroller__high-button { display: none; }
.page-scroll .unity-base-slider__tracker { background-color: #101c23; border-width: 0; }
.page-scroll .unity-base-slider__dragger { background-color: #3a5662; border-color: #3a5662; border-radius: 6px; }
