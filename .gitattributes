* text=auto

*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.dll binary

# Unity serializes empty YAML values with a trailing space by design.
unity-client/**/*.meta -whitespace
unity-client/**/*.asset -whitespace
unity-client/**/*.unity -whitespace
